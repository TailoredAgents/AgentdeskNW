# Fictional demonstration only. Local by default; hosted mode is explicit.
# All API keys remain server-side.
AGENTDESK_DEMO=true
# Required only to explore a compiled Next.js build locally with npm start.
# This does not enable production-safe identity or remote deployment.
AGENTDESK_ALLOW_PRODUCTION_DEMO=false
AGENTDESK_DB_PATH=./data/agentdesk.sqlite
# Generate at least 32 random characters; do not reuse this placeholder.
AGENTDESK_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Optional. Leave blank for deterministic local demonstration tools.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Salesforce, Telegram and licensed research providers are not configured
# by adding arbitrary credentials here. Their production adapters and approval
# gates must be implemented and validated first. See docs/IMPLEMENTATION_ROADMAP.md.

# Responses: supported Astra efforts are low, medium, high, xhigh, max.
# Ultra is a development-agent setting, not an API effort value.
OPENAI_REASONING_EFFORT=high
AGENTDESK_TEXT_MAX_ROUNDS=5
AGENTDESK_TEXT_MAX_TOOL_CALLS=8
AGENTDESK_TEXT_MAX_OUTPUT_TOKENS=8000
AGENTDESK_TEXT_TIMEOUT_MS=90000
AGENTDESK_TEXT_MAX_CONTEXT_BYTES=180000

# Two-way WebRTC voice. Server owns ephemeral credentials and sideband tools.
OPENAI_REALTIME_VOICE=marin
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
AGENTDESK_VOICE_MAX_SECONDS=600
AGENTDESK_VOICE_MAX_TOOL_CALLS=32

# External research is OFF until explicitly selected AND a positive conservative
# per-request estimate is configured. This estimate is not an invoice price or
# guaranteed dollar cap. Public web findings remain unverified.
AGENTDESK_RESEARCH_PROVIDER=synthetic-fixtures-v1
OPENAI_RESEARCH_MODEL=gpt-6-astra
AGENTDESK_RESEARCH_ESTIMATED_REQUEST_CENTS=0
AGENTDESK_RESEARCH_MAX_COST_CENTS=200
AGENTDESK_RESEARCH_MAX_CALLS=2
AGENTDESK_RESEARCH_MAX_SEARCH_CALLS=4
AGENTDESK_RESEARCH_MAX_DURATION_MS=180000
AGENTDESK_RESEARCH_TIMEOUT_MS=45000
AGENTDESK_RESEARCH_MAX_OUTPUT_TOKENS=4000
AGENTDESK_RESEARCH_MIN_INTERVAL_MS=2000
AGENTDESK_RESEARCH_BATCH_SIZE=10
# ATTOM/Regrid/BatchData/contact enrichment are not wired. Adding their keys
# does not activate a provider; licensed account testing and an adapter are needed.

# Private hosted fictional demo (Render). See docs/RENDER_DEMO.md.
# Leave disabled for normal local development.
AGENTDESK_HOSTED_DEMO=false
AGENTDESK_PREPARE_DEMO=false
# On Render, RENDER_EXTERNAL_URL supplies the canonical HTTPS origin.
# Set this only for a chosen custom domain, without a path or query string.
AGENTDESK_APP_ORIGIN=
# Hosted mode accepts a four-digit PIN (including leading zeroes) or a 16–256 character code.
AGENTDESK_DEMO_ACCESS_CODE=

# Employee Copilot messaging. See docs/MESSAGING_SETUP.md.
# Local Slack can use Socket Mode; SMS needs a public HTTPS callback origin.
AGENTDESK_CHANNELS_ENABLED=false
AGENTDESK_CHANNEL_SEND_ENABLED=false
AGENTDESK_CHANNEL_DAILY_LIMIT=50
AGENTDESK_CHANNEL_PUBLIC_ORIGIN=
SLACK_TRANSPORT=socket
SLACK_TEAM_ID=
SLACK_APP_ID=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Required only for the alternative HTTP Events transport.
SLACK_SIGNING_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
