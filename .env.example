# Local demonstration only. All API keys remain server-side.
AGENTDESK_DEMO=true
# Required only to explore a compiled Next.js build locally with npm start.
# This does not enable production-safe identity or remote deployment.
AGENTDESK_ALLOW_PRODUCTION_DEMO=false
AGENTDESK_DB_PATH=./data/agentdesk.sqlite
# Generate at least 32 random characters; do not reuse this placeholder.
AGENTDESK_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Optional. Leave blank for deterministic local demonstration tools.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Salesforce, Telegram, SMS and licensed research providers are not configured
# by adding arbitrary credentials here. Their production adapters and approval
# gates must be implemented and validated first. See docs/IMPLEMENTATION_ROADMAP.md.
