{
  "name": "agentdesk-nw",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "build": "next build",
    "start": "node scripts/run.mjs start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node scripts/smoke-runner.mjs",
    "worker": "node --env-file=.env.local --import tsx scripts/worker.ts",
    "start:render": "node scripts/run.mjs render",
    "demo:prepare": "node --import tsx scripts/prepare-demo.ts",
    "test:hosted": "node scripts/hosted-smoke.mjs",
    "channels:check": "node --import tsx scripts/check-messaging.ts",
    "test:messaging": "node --import tsx scripts/messaging-smoke.ts",
    "test:intelligence": "node scripts/smoke-runner.mjs intelligence",
    "test:conversation": "node scripts/smoke-runner.mjs conversation",
    "test:wallet": "node scripts/smoke-runner.mjs wallet",
    "test:inbox": "node scripts/smoke-runner.mjs inbox",
    "test:communications": "node scripts/smoke-runner.mjs communications"
  },
  "dependencies": {
    "@slack/socket-mode": "3.1.0",
    "better-sqlite3": "11.10.0",
    "lucide-react": "1.64.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "twilio": "6.2.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module"
}
